{
  "name": "agy-market",
  "version": "1.7.0",
  "description": "Community plugin marketplace for Google Antigravity — Sidebar panel UI, SHA-256 verified tarball installer, and npx agy-market bootstrap CLI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "agy-market": "./bin/agy-market.mjs"
  },
  "files": [
    "plugin.json",
    "agy-market.json",
    "assets",
    "bin",
    "scripts",
    "sidecars",
    "skills",
    "src",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/azwosile/agy-market",
  "repository": {
    "type": "git",
    "url": "https://github.com/azwosile/agy-market.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:local": "node scripts/install-local.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "start": "node sidecars/market_pane/main.mjs",
    "test": "node --test test/*.test.mjs"
  }
